{
  "name": "photeryx",
  "version": "0.1.5",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Fast Rust + WebAssembly image processing for the browser.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "tsc --build",
    "build:wasm": "cd wasm-src && wasm-pack build --release --target bundler --out-dir ../src/wasm",
    "build": "npm run build:wasm && npm run build:js && mkdir -p dist/wasm && cp src/wasm/*.{wasm,js} dist/wasm",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mehranTaslimi/photeryx.git"
  },
  "keywords": [
    "rust",
    "wasm",
    "webassembly",
    "image-processing",
    "image-editor",
    "browser",
    "frontend",
    "jpeg",
    "webp"
  ],
  "author": "Mehran Taslimi",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
